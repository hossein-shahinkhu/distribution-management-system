# این فایل نمونه است. برای دیپلوی واقعی آن را کپی کنید:
#   cp .env.example .env
# و مقادیر واقعی را جایگزین کنید. فایل .env نهایی هرگز نباید commit شود.

# --- دیتابیس PostgreSQL ---
DB_NAME=distribution_management
DB_USER=postgres
DB_PASSWORD=change_this_to_a_strong_password

# --- بک‌اند ---
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
# آدرس دقیق دامنه‌ی فرانت‌اند (همان دامنه‌ای که به Caddy می‌دهید)
CORS_ORIGIN=https://yourdomain.com

# --- Caddy / SSL ---
# دامنه‌ای که به IP این سرور اشاره می‌کند
DOMAIN=yourdomain.com
# ایمیل برای دریافت گواهی Let's Encrypt
ACME_EMAIL=you@example.com
